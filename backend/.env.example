# Server Configuration
PORT=5001
NODE_ENV=development
API_BASE_URL=http://localhost:5001
CLIENT_BASE_URL=http://localhost:5173

# Database Configuration (PostgreSQL)
# If PostgreSQL is running locally or in Docker:
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ideacrop_chat
# Fallback storage flag: if true and PostgreSQL cannot be reached, an in-memory/file fallback will ensure zero crashes
DB_FALLBACK_SQLITE=true

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Enable Redis adapter for horizontal scaling (if false or if Redis unavailable, in-memory adapter is used)
USE_REDIS=true

# JWT Secret & Expiry for Staff (Admin/Agents)
JWT_SECRET=super_secret_jwt_key_telecom_sales_chat_987654321
JWT_EXPIRES_IN=7d

# Customer Signed Chat Token Secret & Expiry
CHAT_TOKEN_SECRET=signed_customer_chat_token_secret_telecom_123456789
CHAT_TOKEN_EXPIRY_MINUTES=60

# SMS Gateway Configuration
# Supported providers: "mock" (default for dev/testing) or "twilio"
SMS_GATEWAY_PROVIDER=mock
SMS_FROM_NUMBER=+18005550199

# Twilio Credentials (Required only if SMS_GATEWAY_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Chat Inactivity Auto-Close (minutes)
INACTIVITY_TIMEOUT_MINUTES=30

# File Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
