# Server Configuration
PORT=5001
NODE_ENV=production

# Your Domain
API_BASE_URL=https://chat.ideacorp.website
CLIENT_BASE_URL=https://chat.ideacorp.website

# Database (PostgreSQL recommended for production, or SQLite fallback)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_NAME=ideacrop_chat
DB_FALLBACK_SQLITE=true

# Redis (for Socket.IO horizontal scaling and presence)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
USE_REDIS=true

# JWT & Chat Token Security Keys
JWT_SECRET=production_strong_jwt_secret_key_change_me_987654321
JWT_EXPIRES_IN=7d
CHAT_TOKEN_SECRET=production_strong_customer_chat_token_secret_123456789
CHAT_TOKEN_EXPIRY_MINUTES=60

# SMS & WhatsApp Providers
SMS_GATEWAY_PROVIDER=mock
SMS_FROM_NUMBER=+18005550199
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=

WHATSAPP_PROVIDER=meta
META_WHATSAPP_PHONE_NUMBER_ID=1341183065744312
META_WHATSAPP_ACCESS_TOKEN=your_meta_whatsapp_access_token

# Chat Policy Settings
INACTIVITY_TIMEOUT_MINUTES=30
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
